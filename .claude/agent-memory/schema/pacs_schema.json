      }
    }
  },
  "field_conventions": {
    "id": "主键，character varying(36)，UUID 格式",
    "apply_id": "关联 pacs_apply.id 的外键",
    "pt_id": "患者主索引（patient 域的主键）",
    "visit_id": "就诊流水号，用于关联住院/门诊就诊记录",
    "apply_status": "检查申请状态（smallint，0=待执行）",
    "report_status": "报告状态（integer）",
    "image_status": "影像状态（integer）"
  },
  "cross_domain_relations": {
    "visit_id": "与 inp.public.inp_visit.visit_id、outpatient.public.outp_visit.visit_id 关联",
    "pt_id": "与 patient.public.patient.pt_id 关联",
    "apply_order_no": "对应 HIS 医嘱的申请单号",
    "study_order_no": "DICOM Study Order Number"
  },
  "core_tables_notes": {
    "pacs_apply": "核心主表，存储患者影像检查记录。含完整患者基本信息（姓名、性别、出生日期、年龄、身份证、电话、地址）、检查信息（检查项目、类型、优先级）、临床信息（申请目的、临床表现、诊断）、申请/执行科室医生、状态等。查询影像检查记录优先从该表入手。",
    "pacs_apply_execute": "通过 apply_id 关联 pacs_apply，记录检查执行信息（设备、登记时间、技师等）",
    "pacs_apply_series": "DICOM 层级：检查(Study) → 序列(Series) → 图像(Image)",
    "pacs_apply_series_image": "DICOM 图像层，含 DICOM 标签（TR/TE/b 值等）",
    "pacs_apply_report": "报告内容，通过 apply_id 关联，一个检查可以有多个报告版本"
  }
}
