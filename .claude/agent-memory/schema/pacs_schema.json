          "bpacs_report_term_bind": "报告术语绑定",
          "bpacs_report_term_classify": "报告术语分类",
          "bpacs_report_term_details": "报告术语明细",
          "bpacs_report_term_outline": "报告术语大纲"
        },
        "通用字典": {
          "b_clin_item": "诊疗项目",
          "b_clin_item_class": "诊疗项目分类",
          "b_clin_item_extend": "诊疗项目扩展",
          "b_dept": "科室字典",
          "b_drug": "药品字典",
          "b_drug_class": "药品分类",
