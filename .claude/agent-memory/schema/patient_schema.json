            },
            "infection_decision_rule": {
              "description": "传染病判定规则"
            },
            "infection_disease_vs": {
              "description": "传染病关联"
            },
            "infection_lab": {
              "description": "传染病检验关联"
            },
            "infection_pacs": {
              "description": "传染病检查关联"
            },
            "infection_report": {
              "description": "传染病报告"
            },
