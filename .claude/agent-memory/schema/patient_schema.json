            },
            "service_item": {
              "description": "服务项目"
            },
            "read_card_config": {
              "description": "读卡配置"
            },
            "rc_card_manage": {
              "description": "卡管理"
            },
            "rc_disease_vs": {
              "description": "读卡疾病关联"
            },
            "rc_fill_record": {
              "description": "卡填写记录"
            },
            "fill_card_rule": {
              "description": "填卡规则"
            },
            "decision_rule": {
              "description": "判定规则"
            },
            "trans_process": {
              "description": "事务处理"
            }
          }
        }
      }
    },
    "uas": {
      "description": "预约排班",
      "modules": {
        "预约排班": {
          "tables": {
            "appt_schedule": {
              "description": "预约排班表"
            },
            "appt_schedule_group": {
              "description": "排班组"
            },
            "appt_schedule_interval": {
              "description": "排班时段间隔"
            },
            "appt_schedule_period": {
              "description": "排班时段"
            },
            "appt_schedule_recipient": {
              "description": "排班接收者"
            },
            "appt_schedule_shift": {
              "description": "排班班次"
            },
            "schedule_business": {
              "description": "排班业务"
            },
            "unified_appt_record": {
              "description": "统一预约记录"
            }
          }
        }
      }
    }
  },
  "field_conventions": {
    "id": "主键统一使用 UUID (varchar 36)",
    "pt_id": "患者ID，关联 qw_base.bhis_pt_info.id",
    "org_id": "机构编码 (varchar 36)",
    "visit_id": "就诊ID（跨域关联键，对应服务记录）",
    "status": "状态字段多使用 smallint"
  },
  "cross_domain_relations": {
    "visit_id": "与 inp.public.inp_visit.visit_id、outpatient.public.outp_visit.visit_id、fee 域各结算表关联。在 patient 域中 visit_id 对应 service_record.id",
    "patient_id / pt_id": "对应 qw_base.bhis_pt_info.id，是患者域的主键标识，其他域通过此ID引用患者"
  },
  "notes": {
    "blood_type": "bhis_pt_info 无直接血型字段。extra_info（json 类型）经验证不存储血型数据。patient 域无专用血型关联表（pt_blood_type 等均不存在）。血型字典在 qw_base.b_abo（ABO）和 qw_base.b_rh（Rh）中。b_past_item_category 定义了 ABO 血型(code=01, is_unique=1) 和 RH 血型(code=02, is_unique=1) 类别，理论上血型可通过 pt_past 表以 item_code='01'/'02' 存储，但当前数据未见实际使用。血型实际存储位置可能在 emr 域的既往史/体征表或检验域中",
    "past_history": "既往史、个人史、婚育史、家族史统一存储在 pt_past 表中，由 item_code（关联 b_past_item_category.code）区分类别",
    "qw_base_note": "patient 域的 qw_base 与其它域不同——它存储的是患者核心数据主表（bhis_pt_info），而非纯字典同步副本。字典表（b_sex、b_abo 等）也在此 schema 下共存",
    "empoy_adderss": "bhis_pt_info 字段 employ_adderss 拼写如此（adderss 少一个 d ），不是笔误，查询时保持原拼写"
  }
}
