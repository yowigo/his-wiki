{
  "domain": "drug",
  "domain_name": "药品域",
  "database": "drug",
  "schemas": {
    "public": {
      "description": "药品业务主表（库存、出入库、发药、采购等）",
      "modules": {
        "库存管理": {
          "tables": {
            "drug_stock": {
              "description": "药品库存表（各库房实时库存）",
              "key_fields": ["drug_id", "storehouse_id", "batch_no"],
              "relations": {
                "drug_id": "qw_base.b_drug.id"
              }
            },
            "drug_stock_change": {
              "description": "库存变动记录"
            },
            "drug_stock_backup": {
              "description": "库存备份"
            },
            "drug_inventory": {
              "description": "盘点单"
            },
            "drug_inventory_detail": {
              "description": "盘点明细"
            },
            "drug_balance": {
              "description": "期初/期末结存"
            },
            "drug_balance_detail": {
              "description": "结存明细"
            }
          }
        },
        "出入库管理": {
          "tables": {
            "drug_io": {
              "description": "药品出入库主表（含入库、出库、调拨等）",
              "key_fields": ["io_id", "storehouse_id", "io_type", "io_date"]
            },
            "drug_io_detail": {
              "description": "出入库明细",
              "key_fields": ["io_id", "drug_id", "quantity", "price"]
            },
            "drug_apply": {
              "description": "药品申领单"
            },
            "drug_apply_detail": {
              "description": "申领明细"
            },
            "drug_receipt": {
              "description": "药品收货单"
            },
            "drug_receipt_detail": {
              "description": "收货明细"
            },
            "drug_purchase_plan": {
              "description": "采购计划"
            },
            "drug_purchase_plan_detail": {
              "description": "采购计划明细"
            },
            "drug_return": {
              "description": "药品退货"
            }
          }
        },
        "发药管理": {
          "tables": {
            "drug_give": {
              "description": "发药单主表"
            },
            "drug_give_detail": {
              "description": "发药明细"
            },
            "drug_give_wait": {
              "description": "待发药记录"
            },
            "drug_execution": {
              "description": "药疗执行记录"
            },
            "drug_execution_log": {
              "description": "执行日志"
            },
            "dispensing_window": {
              "description": "发药窗口"
            }
          }
        },
        "药品养护与质量": {
          "tables": {
            "drug_conserve": {
              "description": "药品养护记录"
            },
            "drug_conserve_detail": {
              "description": "养护明细"
            },
            "drug_conserve_measures": {
              "description": "养护措施"
            },
            "drug_conserve_quality": {
              "description": "养护质量"
            },
            "drug_conserve_set": {
              "description": "养护配置"
            },
            "drug_quality": {
              "description": "药品质量记录"
            }
          }
        },
        "调价": {
          "tables": {
            "drug_adjust_price": {
              "description": "药品调价记录"
            }
          }
        },
        "结算": {
          "tables": {
            "drug_settlement": {
              "description": "药品结算单"
            },
            "drug_settlement_detail": {
              "description": "结算明细"
            }
          }
        },
        "医保药品管理": {
          "tables": {
            "mc_check_accept": {
              "description": "医保药品验收单"
            },
            "mc_check_accept_detail": {
              "description": "验收明细"
            },
            "mc_purchase_apply": {
              "description": "医保药品采购申请"
            },
            "mc_purchase_apply_detail": {
              "description": "采购申请明细"
            },
            "mc_settlement": {
              "description": "医保结算"
            },
            "mc_settlement_detail": {
              "description": "医保结算明细"
            },
            "mc_transfer_application": {
              "description": "调拨申请"
            },
            "mc_transfer_application_details": {
              "description": "调拨申请明细"
            },
            "mc_use": {
              "description": "医保药品使用"
            },
            "mc_use_detail": {
              "description": "医保药品使用明细"
            }
          }
        },
        "处方点评": {
          "tables": {
            "prescription_review": {
              "description": "处方点评主表"
            },
            "pr_review_project": {
              "description": "点评项目"
            },
            "pr_review_project_type": {
              "description": "点评项目类型"
            },
            "pr_irrational_problem": {
              "description": "不合理问题"
            },
            "pr_sample_plan": {
              "description": "抽样计划"
            },
            "pr_sample_plan_content": {
              "description": "抽样内容"
            },
            "pr_sample_recipel": {
              "description": "抽样处方"
            },
            "pr_sample_record": {
              "description": "抽样记录"
            },
            "pr_appeal_record": {
              "description": "申诉记录"
            },
            "pr_rule_compatibility_taboo": {
              "description": "配伍禁忌规则"
            },
            "pr_rule_crowd_taboo": {
              "description": "人群禁忌规则"
            },
            "pr_rule_dose_usage": {
              "description": "剂量用法规则"
            },
            "pr_rule_irrational_detail": {
              "description": "不合理规则明细"
            },
            "pr_rule_repeat": {
              "description": "重复用药规则"
            }
          }
        },
        "其他辅助表": {
          "tables": {
            "drug_traceability_code": {
              "description": "药品追溯码记录"
            },
            "drug_traceability_code_stock": {
              "description": "追溯码库存关联"
            },
            "drug_storehouse_lock": {
              "description": "库房锁定记录"
            },
            "drug_download_log": {
              "description": "数据下载日志"
            },
            "data_syn": {
              "description": "数据同步记录"
            },
            "trans_process": {
              "description": "事务处理过程"
            },
            "match_result": {
              "description": "对码/匹配结果"
            },
            "zl对码管理": {
              "description": "对码管理表（中文名）"
            },
            "zl脚本内容": {
              "description": "系统脚本内容（中文名）"
            },
            "zl脚本模块": {
              "description": "系统脚本模块（中文名）"
            },
            "库存导入临时表": {
              "description": "库存导入临时表（中文名）"
            }
          }
        }
      }
    },
    "qw_base": {
      "description": "从上游同步的本地药品字典副本（核心数据源）",
      "sync_tables": {
        "b_drug": {
          "description": "药品基础字典（核心表）—— 每种药品的一条记录，含规格、价格、批准文号、国药码等",
          "key_fields": ["id", "code", "name", "variety_id", "status"],
          "key_fields_detail": {
            "id": "主键 UUID",
            "code": "药品代码",
            "name": "药品名称",
            "strength": "规格（如 100*瓶、散药 1g）",
            "brand_name": "商品名",
            "english_name": "英文名",
            "alias": "别名",
            "py_code": "拼音码",
            "wb_code": "五笔码",
            "variety_id": "品种ID（FK → b_drug_variety）",
            "category": "药品分类（1-西药 2-中成药 3-中药饮片 4-材料 5-制剂 7-其他等）",
            "manufacturer": "生产厂商（名称，非ID）",
            "sourceland": "产地",
            "approval_no": "批准文号",
            "country_code": "国家医保药品编码（国药码）",
            "platform_code": "平台编码（省平台挂网编码）",
            "platform_name": "平台名称",
            "cost_price": "采购价",
            "purchase_cost_price": "采购成本价",
            "limit_price": "限价",
            "unit": "基本单位",
            "take_unit": "服用单位",
            "outp_unit": "门诊发药单位",
            "outp_unit_coefficient": "门诊转换系数",
            "inp_unit": "住院发药单位",
            "inp_unit_coefficient": "住院转换系数",
            "purchase_unit": "采购单位",
            "purchase_unit_coefficient": "采购转换系数",
            "min_pack_unit_coefficient": "最小包装单位转换系数（转换比）",
            "ddd": "限定日剂量 DDD",
            "ddd_unit_coefficient": "DDD 单位系数",
            "dosage_coefficient": "剂量系数",
            "essential_drugs_code": "基药编码",
            "essential_drugs_class": "基药分类",
            "add_rate": "加价率",
            "price_level": "价格级别",
            "source": "药品来源",
            "fee_type": "收费类别",
            "fee_type_code": "收费类别代码",
            "tcm_type": "中药类型",
            "service_object": "服务对象",
            "batch_no": "批号",
            "is_gmp": "是否 GMP 认证",
            "status": "状态（1-正常 0-停用）",
            "is_traceability": "是否追溯",
            "tax_rate": "税率",
            "tax_code": "税收编码",
            "apply_range": "适用范围",
            "org_id": "机构ID",
            "ypid": "药品ID（YPID）",
            "bidder_no": "投标人编号",
            "purchase_method": "采购方式",
            "volume": "体积",
            "is_subpackage": "是否可分包",
            "is_bulk": "是否大宗药品",
            "traceability_code_prefix": "追溯码前缀",
            "traceability_code_unit": "追溯码单位",
            "traceability_code_length": "追溯码长度",
            "is_dispensing_drug": "是否调配药品",
            "max_expiry": "最大有效期（月）",
            "conserve_period": "养护周期（月）",
            "standard_code": "标准编码",
            "identifier": "标识号",
            "production_date": "生产日期",
            "supplier": "供应商"
          },
          "relations": {
            "variety_id": "b_drug_variety.id",
            "drug_id": "bhis_drug_price.drug_id, bhis_drug_approval_no.drug_id, bhis_drug_limit.drug_id, b_drug_winner.drug_id, drug_stock.drug_id"
          }
        },
        "b_drug_variety": {
          "description": "药品品种表 —— 通用名层级，一个品种对应多个 drug（不同厂家/规格）",
          "key_fields": ["id", "code", "name", "class_id", "form"],
          "key_fields_detail": {
            "id": "主键 UUID",
            "code": "品种编码",
            "name": "品种名称（通用名）",
            "category": "分类（同 b_drug.category）",
            "class_id": "药品分类ID（FK → b_drug_class）",
            "form": "剂型编码（FK → b_drug_form.code）",
            "dosage_unit": "剂量单位",
            "toxicology_class": "毒理分类",
            "value_class": "价值分类",
            "anti_type": "抗菌药类型（1-非限制 2-限制 3-特殊使用 0-非抗菌药）",
            "is_hormone": "是否激素",
            "is_skin_test": "是否皮试",
            "is_first_aid": "是否急救",
            "is_new_drug": "是否新药",
            "is_no_bulk": "是否不拆分",
            "is_package": "是否包装",
            "is_avoid_decoct": "是否免煎",
            "is_prescription": "是否处方药",
            "is_generics": "是否仿制药",
            "is_import_original": "是否原研进口",
            "is_infusion": "是否输液",
            "is_radioactive_drug": "是否放射性药品",
            "high_caution": "高危药品分类",
            "oncology_drug_category": "肿瘤药品分类",
            "recipe_grade": "处方等级",
            "insurance_grade": "医保等级",
            "recipe_limit": "处方限量",
            "use_limit": "使用限量",
            "limit_cycle": "限用周期",
            "service_object": "服务对象",
            "sex": "适用性别",
            "py_code": "拼音码",
            "wb_code": "五笔码",
            "status": "状态（1-正常 0-停用）",
            "apply_range": "适用范围",
            "org_id": "机构ID"
          },
          "relations": {
            "class_id": "b_drug_class.id",
            "id": "b_drug.variety_id"
          }
        },
        "b_drug_class": {
          "description": "药品分类字典（树形，通过 parent_id 实现层级）",
          "key_fields": ["id", "code", "name", "parent_id", "category"],
          "key_fields_detail": {
